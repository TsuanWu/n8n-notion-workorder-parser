    {
      "parameters": {
        "jsCode": "const source = $('解析 AI 判讀結果1').item.json;\nconst results = $input.first().json.results ?? [];\nconst textOf = (block) => {\n  const data = block?.[block.type] ?? {};\n  const rich = data.rich_text ?? data.text ?? [];\n  return Array.isArray(rich) ? rich.map(item => item.plain_text ?? item.text?.content ?? '').join('') : '';\n};\nconst heading = results.find(block => String(textOf(block)).replace(/\\s/g, '').replace(/：/g, ':') === '工項:');\nconst taskBlocks = (Array.isArray(source.tasks) ? source.tasks : [])\n  .filter(task => typeof task === 'string' && task.trim())\n  .map(task => ({ object: 'block', type: 'to_do', to_do: { rich_text: [{ type: 'text', text: { content: task.trim() } }], checked: false } }));\nconst text = (content) => ({ type: 'text', text: { content } });\nconst children = heading\n  ? taskBlocks\n  : [\n      { object: 'block', type: 'heading_2', heading_2: { rich_text: [text('工項：')] } },\n      ...taskBlocks,\n      { object: 'block', type: 'divider', divider: {} },\n      { object: 'block', type: 'heading_2', heading_2: { rich_text: [text('成果回報：')] } },\n      { object: 'block', type: 'paragraph', paragraph: { rich_text: [] } },\n      { object: 'block', type: 'divider', divider: {} },\n      { object: 'block', type: 'heading_2', heading_2: { rich_text: [text('回報文件：')] } },\n      { object: 'block', type: 'paragraph', paragraph: { rich_text: [] } },\n    ];\nconst requestBody = heading\n  ? { children, position: { type: 'after_block', after_block: { id: heading.id } } }\n  : { children };\nreturn [{ json: { page_id: source.page_id, request_body: JSON.stringify(requestBody) } }];"
      },
