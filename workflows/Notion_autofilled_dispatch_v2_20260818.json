    {
      "parameters": {
        "jsCode": "const page = $('取得頁面內 PDF 候選').item.json;\nconst blocks = $input.first().json.results ?? [];\nconst isFile = (block) => block.type === 'pdf' || block.type === 'file';\nconst isEmptyParagraph = (block) => block.type === 'paragraph' && !(block.paragraph?.rich_text ?? []).some(item => (item.plain_text ?? item.text?.content ?? '').trim());\nconst meaningful = blocks.filter(block => !isEmptyParagraph(block));\nconst files = meaningful.filter(isFile);\nconst candidate = files[0];\nconst fileInfo = candidate?.[candidate?.type];\nconst source = fileInfo?.file ?? fileInfo?.external;\nconst title = (page.properties?.Name?.title ?? []).map(item => item.plain_text ?? item.text?.content ?? '').join('').trim() || '派工單';\nconst safeName = title.replace(/[\\\\/:*?\"<>|]/g, '_');\nconst isPdf = candidate?.type === 'pdf' || /\\.pdf(?:$|[?#])/i.test(source?.url ?? '') || /pdf/i.test(fileInfo?.name ?? '');\nreturn [{ json: {\n  page_id: page.id ?? null,\n  source_block_id: candidate?.id ?? null,\n  pdf_url: source?.url ?? null,\n  file_name: /\\.pdf$/i.test(fileInfo?.name ?? '') ? fileInfo.name : safeName + '.pdf',\n  should_recover: meaningful.length === 1 && files.length === 1 && Boolean(source?.url) && isPdf,\n} }];"
      },
